# Solo se usan para FIRMAR la versión release de Android (no hay secretos en la app).
# Copia a .env (nunca se versiona) o defínelas en la terminal / GitHub Secrets.
# Si ANDROID_KEYSTORE_PATH no está definida, la build release usa la llave de depuración.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
